		cout << i+1 << ". " << nomes[i] << "\n";
		
	}
	
	for (i = 0; i < total - 1; i++) {
		
		for(j = i+1; j < total; j++){
			
			if (strcmp(nomes[i], nomes[j]) > 0) {
				temp = nomes[i];
				nomes[i] = nomes[j];
				nomes[j] = temp;
			}
			
		}
		
	}
	
	cout << "* Após a Ordenação: \n\n";
	
	for (i = 0; i < total; i++) {
		
		cout << i+1 << ". " << nomes[i] << "\n";
		
	}
	
	return 0;
	
}